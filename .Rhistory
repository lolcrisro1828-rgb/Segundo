ymax = y[x <= input$b],
name = paste0(
"P(X < ",
input$b,
") = ",
pB
),
fillcolor = "rgba(0,255,0,0.35)",
line = list(color = "transparent")
) %>%
# Área C
add_ribbons(
x = x[
x >= input$c[1] &
x <= input$c[2]
],
ymin = 0,
ymax = y[
x >= input$c[1] &
x <= input$c[2]
],
name = paste0(
"P(",
input$c[1],
" < X < ",
input$c[2],
") = ",
pC
),
fillcolor = "rgba(255,0,0,0.35)",
line = list(color = "transparent")
) %>%
layout(
title = "Distribución Normal Interactiva",
xaxis = list(
title = "Meses"
),
yaxis = list(
title = "Densidad"
)
)
})
